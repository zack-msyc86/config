{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true
  },
  "include": ["src"]
}
